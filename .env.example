# Copy this file to .env and fill in your values

# OpenAI API key — get it at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Model to use for text extraction (gpt-4o recommended for structured output)
OPENAI_MODEL=gpt-4o

# ── Image generation (used in design_report mode) ──────────────────────────────
# Verify connectivity before first use:  python main.py --test-image
#
# Recommended models (GPT Image generation, 2026):
#   gpt-image-2          — preferred, higher quality  (b64_json response)
#   gpt-image-1          — fallback, slightly faster  (b64_json response)
#   chatgpt-image-latest — alias for the latest GPT Image model
#
# Note: dall-e-3 and dall-e-2 are previous-generation models and may not be
# available in all OpenAI projects. Use GPT Image models for new projects.
IMAGE_MODEL=gpt-image-2

# Image dimensions (gpt-image-1/2):
#   1024x1024  — square (default, fastest)
#   1536x1024  — landscape
#   1024x1536  — portrait
IMAGE_SIZE=1024x1024

# Image quality (gpt-image-1/2): low, medium, high, auto
IMAGE_QUALITY=medium

# ── Logging ────────────────────────────────────────────────────────────────────
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
