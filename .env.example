# Copy this file to .env and fill in your values

# OpenAI API key — get it at https://platform.openai.com/api-keys
# The full content of any dialog file you process is sent to OpenAI using
# this key. See README "Приватность и ограничения" before using real data.
OPENAI_API_KEY=sk-...

# Model used for text extraction (Chat Completions). gpt-4o is this
# project's tested default — not a claim that it is the "latest" or
# universally "preferred" OpenAI model.
OPENAI_MODEL=gpt-4o

# ── Image generation (used in design_report mode) ──────────────────────────────
# Each image generation call is a separate, billable request. Skip it with
# `python main.py ... --mode design_report --no-image`.
# Verify connectivity and see which models your account can access before
# first use — this also makes a real, billable request:
#   python main.py --test-image
#
# gpt-image-2 is this project's configured default. Actual model
# availability depends on your OpenAI account/project — check with
# --test-image rather than assuming a given model is accessible.
# dall-e-3 / dall-e-2 are previous-generation models and may not be
# available on newer accounts.
IMAGE_MODEL=gpt-image-2

# Image dimensions (gpt-image-1/2):
#   1024x1024  — square (default, fastest)
#   1536x1024  — landscape
#   1024x1536  — portrait
IMAGE_SIZE=1024x1024

# Image quality (gpt-image-1/2): low, medium, high, auto
IMAGE_QUALITY=medium

# ── Logging ────────────────────────────────────────────────────────────────────
# Log level: DEBUG, INFO, WARNING, ERROR
# Even at DEBUG, logs never include the full dialog text or the full raw
# model response — only safe metadata such as sizes, counts and model name.
LOG_LEVEL=INFO
